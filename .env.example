# ---------------------------------------------------------------------------
# NecroReview configuration. Copy to `.env` and edit. Every value is optional:
# the demo runs end-to-end with no network and no agent login.
# ---------------------------------------------------------------------------

# --- Data source -----------------------------------------------------------
# owner/repo whose review culture we resurrect.
NRR_OWNER=storybookjs
NRR_REPO=storybook

# Where fetched data, personas and indexes live (default: ./data)
NRR_DATA_DIR=./data

# How many pages of 100 review comments to pull, newest first.
NRR_COMMENT_PAGES=25

# How many pages of 100 commits to scan for fix/revert patterns.
NRR_COMMIT_PAGES=10

# --- Ghost selection -------------------------------------------------------
# How many top reviewers become ghosts.
NRR_GHOST_COUNT=4

# --- Bridge server (the "stage") -------------------------------------------
NRR_BRIDGE_PORT=4001
NRR_UI_ORIGIN=http://localhost:4000

# --- GitBot HQ (the "backstage") -------------------------------------------
GITBOT_URL=http://localhost:3000

# `live` drives real Claude Code / Codex sessions through GitBot HQ.
# `offline` uses the deterministic ghost brain (no tokens, no network).
# Default when unset: try live, fall back to offline automatically.
NRR_MODE=

# Which agent harness live ghosts run on: claude-code | codex | opencode
NRR_AGENT=claude-code

# Working copy agents read. Optional even in live mode.
NRR_REPO_PATH=./storybook

# --- Demo PR ---------------------------------------------------------------
# PR the demo reviews. Set to 0 to use the bundled offline fixture diff.
NRR_DEMO_PR=32464
NRR_DEMO_PR_TITLE=fix: avoid infinite render loop in useArgs
